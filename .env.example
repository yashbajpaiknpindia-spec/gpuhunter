# GPU Profit Hunter — never commit real credentials.
APP_HOST=127.0.0.1
APP_PORT=8088
# Login page username; defaults to gph if omitted.
APP_USER=gph
APP_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Render existing-service deployment: paste your existing Render PostgreSQL URL here.
# Use Internal Database URL when service and DB share a region. REQUIRED on Render; no Blueprint needed.
# Keep this file private and never commit real credentials. Local-only developers may leave it blank.
DATABASE_URL=
DATABASE_PATH=./data/gph.sqlite3

# Provider credentials
VAST_API_KEY=
# Official Vast REST API host; leave unset to use this default.
VAST_API_BASE=https://cloud.vast.ai/api/v0
WHATTOMINE_API_TOKEN=
# Public Kryptex Pool telemetry; no private Kryptex account token is needed.
KRYPTEX_MINING_USERNAME=
KRYPTEX_COIN=prl
KRYPTEX_WORKER=worker

# Refresh policy: Vast offers and Kryptex worker/coin telemetry every 60s.
# Kryptex GPU reference rows and WhatToMine GPU revenue calculations refresh every 60s by default.
# WhatToMine coin identity/algorithm catalogue remains cached for 5 minutes to reduce quota use.
KRYPTEX_POLL_INTERVAL_SECONDS=60
KRYPTEX_GPU_SCAN_INTERVAL_SECONDS=60
KRYPTEX_GPU_REFERENCE_CACHE_SECONDS=60
# Off by default: this per-GPU route is not listed in Kryptex's public Pool API docs.
# Enable only after independently verifying the endpoint and that its daily-revenue fields are comparable.
KRYPTEX_GPU_REFERENCE_ENABLED=false
SCAN_INTERVAL_SECONDS=60
WHATTOMINE_COINS_CACHE_SECONDS=300
WHATTOMINE_CALC_CACHE_SECONDS=60

# Safe by default. Do not enable live mode until all gates are verified.
AUTOMATION_MODE=scan
ENABLE_LIVE_MINING=false
MINING_ELIGIBILITY_CONFIRMED=false
VAST_CREDIT_SOURCE=unknown
REQUIRE_POOL_METRICS_FOR_LIVE=true
AUTO_SCAN_ENABLED=true
AUTO_RENT_ENABLED=false

# Set either hourly cap to 0 to disable that fixed price ceiling. Other profit/spend gates remain active.
MAX_GPU_HOURLY_USD=0
MAX_TOTAL_HOURLY_USD=0
MAX_DAILY_SPEND_USD=1.75
# UI can select 0..3 instances. Increase only after reviewing your total daily budget.
# Legacy compatibility setting; the saved dashboard target (0–25) is the live target ceiling.
MAX_ACTIVE_INSTANCES=3
MIN_RELIABILITY=0.99
MIN_REVENUE_COST_RATIO=1.50
MIN_NET_PROFIT_USD_DAY=0.50
REVENUE_HAIRCUT=0.30
BANDWIDTH_RESERVE_USD_DAY=0.05
DEFAULT_POOL_FEE_PCT=1.0
DEFAULT_MINER_FEE_PCT=2.0
DEFAULT_DISK_GB=12
MAX_DISK_GB=20

# Monitoring. 0 means no fixed runtime ceiling; safety checks still stop failing/losing instances.
MAX_PROFIT_DATA_AGE_MINUTES=15
MONITOR_INTERVAL_SECONDS=45
STARTUP_GRACE_MINUTES=10
MAX_NO_SHARE_MINUTES=15
MIN_OBSERVED_HASHRATE_RATIO=0.70
MAX_INSTANCE_RUNTIME_HOURS=0

# Remote SSH monitoring. On Render use a Secret File and point at its /etc/secrets/... path.
SSH_PRIVATE_KEY_PATH=
SSH_CONNECT_TIMEOUT_SECONDS=8
MINER_PROFILES_PATH=./data/mining_profiles.json
WALLETS_PATH=./data/wallets.json

# --- Vast search quota (rows/day) -------------------------------------------------------
# Vast meters GET /bundles/ by ROWS returned against a daily quota (20,000/day on this
# account; resets at 00:00 UTC), not by request count. The app paces automatic scans so the
# rows last the whole day; SCAN_INTERVAL_SECONDS is only the minimum gap.
VAST_DAILY_ROW_BUDGET=20000
VAST_ROW_RESERVE=1500
VAST_SEARCH_LIMIT=100
VAST_AUDIT_LIMIT=40
VAST_AUDIT_INTERVAL_SECONDS=3600
VAST_SEARCH_ORDER=dph_total

# OPTIONAL search-only keys from OTHER Vast accounts (comma separated). They are used ONLY for
# offer searches, each with its own daily row counter (VAST_DAILY_ROW_BUDGET per key). Renting,
# payment, balance, monitoring and destroy ALWAYS use VAST_API_KEY (the funded account).
# Each search-only account needs no balance. Check Vast's terms before adding accounts.
VAST_SEARCH_API_KEYS=
